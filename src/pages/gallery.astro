---
import Base from '../layouts/Base.astro';
import { gallery } from '../data/site.js';
---
<Base
  title="Gallery | Budget Aluminium"
  description="Recent work by Budget Aluminium: sunrooms, decks, exteriors and home renovations across the Lower Mainland."
>
<main>
  <section style="max-width:1440px;margin:0 auto;padding:clamp(48px,6vw,96px) clamp(20px,4vw,56px) 32px"><h1 style="font-family:'Sora',sans-serif;font-weight:800;letter-spacing:-0.04em;font-size:clamp(56px,7.4vw,128px);line-height:0.9;margin:0">Gallery</h1></section>
  <section style="max-width:1440px;margin:0 auto;padding:0 clamp(20px,4vw,56px) clamp(64px,8vw,112px);display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,320px),1fr));gap:4px">
    {gallery.map((g) => (
      <figure style="margin:0;position:relative;aspect-ratio:4/3;overflow:hidden;background:#9EA4A9"><img src={g.img} alt={g.label} loading="lazy" style="width:100%;height:100%;object-fit:cover" /><figcaption style="position:absolute;left:0;bottom:0;background:#17191B;color:#EDEFF1;font-size:14px;font-weight:600;padding:6px 12px">{g.label}</figcaption></figure>
    ))}
  </section>
</main>
</Base>
