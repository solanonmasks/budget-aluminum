---
import Base from '../layouts/Base.astro';

// Roof options. `dark: true` gives the black card with a gold heading.
const roofs = [
  { title: 'Tempered glass', text: 'Clear or tinted. Keeps the light, stops the rain.' },
  { title: 'Aluminium W-panel', text: 'Solid shade, the classic low-maintenance cover.' },
  { title: 'Polycarbonate', text: 'Multi-layer sheet, light-filtering and UV resistant.' },
  { title: 'Acrylic', text: 'Multi-layer acrylic for a brighter covered space.' },
  { title: 'Insulated panel', text: 'Quieter in the rain and cooler underneath.' },
  { title: 'Window and door awnings', text: 'Polycarbonate awnings in 2 or 3 ft projections.', dark: true },
];
---
<Base
  title="Patio Covers & Awnings | Budget Aluminium"
  description="Glass, aluminium W-panel, polycarbonate, acrylic and insulated patio covers, plus window and door awnings. Use the patio all year, rain or shine. Free estimates across the Lower Mainland."
>
<main>
  <section style="background:#17191B;color:#EDEFF1">
    <div style="max-width:1440px;margin:0 auto;padding:clamp(48px,6vw,96px) clamp(20px,4vw,56px)">
      <span style="font-weight:700;font-size:13px;letter-spacing:0.22em;color:#C9A23A">PATIO COVERS &amp; AWNINGS</span>
      <h1 style="font-family:'Sora',sans-serif;font-weight:800;font-size:clamp(54px,7.4vw,128px);line-height:0.9;letter-spacing:-0.05em;margin:14px 0 0;max-width:10em">Use the patio <span style="color:#C9A23A">all year.</span></h1>
      <p style="margin:24px 0 0;max-width:34em;font-size:20px;color:#C9CDD1">A patio cover turns the back of the house into extra living space for the BBQ, the table and the fire pit, rain or shine. It adds value if you ever sell.</p>
    </div>
  </section>
  <section style="max-width:1440px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px)">
    <h2 style="font-family:'Sora',sans-serif;font-weight:800;font-size:clamp(40px,4.4vw,72px);line-height:0.96;letter-spacing:-0.045em;margin:0 0 32px">Choose your roof</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:2px;background:#9EA4A9">
      {roofs.map((r) => r.dark ? (
        <div style="background:#17191B;color:#EDEFF1;padding:28px"><h3 style="font-family:'Sora',sans-serif;font-weight:800;font-size:26px;letter-spacing:-0.03em;margin:0 0 6px;color:#C9A23A">{r.title}</h3><p style="margin:0;color:#C9CDD1">{r.text}</p></div>
      ) : (
        <div style="background:#E6E8EA;padding:28px"><h3 style="font-family:'Sora',sans-serif;font-weight:800;font-size:26px;letter-spacing:-0.03em;margin:0 0 6px">{r.title}</h3><p style="margin:0;color:#3D4247">{r.text}</p></div>
      ))}
    </div>
  </section>
</main>
</Base>
