---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';

const field = 'font-size:18px;padding:16px;border:2px solid #9EA4A9;background:#EDEFF1;color:#17191B';
const label = 'display:flex;flex-direction:column;gap:8px;font-weight:600';
---
<Base
  title="Book a Free Estimate | Budget Aluminium"
  description="Tell us what you’re planning and we’ll book a time to measure. Call 604 783 8356 or send a request for a free estimate on a patio cover, sunroom, railing, fence, gate or deck."
  hideCta
>
<main>
  <section style="max-width:1440px;margin:0 auto;padding:clamp(48px,6vw,96px) clamp(20px,4vw,56px) clamp(64px,8vw,112px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:48px 80px;align-items:start">
    <div>
      <h1 style="font-family:'Sora',sans-serif;font-weight:800;font-size:clamp(52px,6.6vw,112px);line-height:0.92;letter-spacing:-0.05em;margin:0 0 18px">Book a free estimate</h1>
      <p style="margin:0 0 32px;font-size:20px;color:#3D4247">Tell us what you’re planning and we’ll book a time to measure.</p>

      <form id="quote-form" action={site.formEndpoint} method="POST" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:18px">
        <label style={label}>Name<input required name="name" autocomplete="name" style={field} /></label>
        <label style={label}>Phone<input required type="tel" name="phone" autocomplete="tel" style={field} /></label>
        <label style={label}>Email<input type="email" name="email" autocomplete="email" style={field} /></label>
        <label style={label}>City
          <select name="city" style={field}>{site.formCities.map((c) => <option>{c}</option>)}</select></label>
        <label style={`grid-column:1/-1;${label}`}>What are you interested in?
          <select name="need" style={field}>{site.formNeeds.map((n) => <option>{n}</option>)}</select></label>
        <label style={`grid-column:1/-1;${label}`}>Details
          <textarea name="desc" rows="5" placeholder="Back patio is about 12 x 20 ft. Looking at a tinted glass cover and new glass railing on the deck." style={`${field};resize:vertical;line-height:1.5`}></textarea></label>
        <input type="hidden" name="_subject" value="New estimate request from the website" />
        <div style="grid-column:1/-1"><button type="submit" class="btn-submit">Send request</button></div>
        <p id="form-error" role="alert" hidden style="grid-column:1/-1;margin:0;color:#8A1C1C;font-weight:600">Sorry, something went wrong sending your request. Please try again, or call us at <a href={`tel:${site.phone.tel}`}>{site.phone.display}</a>.</p>
      </form>

      <div id="form-thanks" hidden style="background:#17191B;color:#EDEFF1;padding:clamp(28px,4vw,48px);flex-direction:column;gap:12px">
        <h2 style="font-family:'Sora',sans-serif;font-weight:800;font-size:44px;letter-spacing:-0.04em;line-height:1;margin:0;color:#C9A23A">Thanks, we’ll be in touch.</h2>
        <p style="margin:0">We’ll call to book your free estimate.</p>
        <div><button type="button" id="form-reset" style="background:#C9A23A;color:#17191B;border:none;font-weight:700;font-size:16px;padding:12px 20px;cursor:pointer">Send another</button></div>
      </div>
    </div>
    <aside style="background:#17191B;color:#EDEFF1;padding:clamp(32px,4vw,56px);display:flex;flex-direction:column;gap:24px;border-top:6px solid #C9A23A">
      <div><span style="font-weight:700;font-size:13px;letter-spacing:0.22em;color:#C9A23A">CALL NOW</span><a href={`tel:${site.phone.tel}`} style="display:block;font-family:'Sora',sans-serif;font-weight:800;font-size:clamp(44px,4.6vw,72px);letter-spacing:-0.04em;line-height:1;color:#FFFFFF;text-decoration:none;margin-top:6px">{site.phone.display}</a></div>
      <div><strong style="display:block;color:#C9A23A">Payment plans</strong><a href={site.links.financeit} target="_blank" rel="noopener" style="color:#EDEFF1">Apply for financing</a></div>
      <div><strong style="display:block;color:#C9A23A">Service area</strong>{site.contactServiceArea}</div>
    </aside>
  </section>
</main>
</Base>

<style>
  #form-thanks:not([hidden]) { display: flex; }
</style>

<script is:inline>
  // Sends the form to Formspree without leaving the page, then shows the thank-you box.
  (function () {
    var form = document.getElementById('quote-form');
    var thanks = document.getElementById('form-thanks');
    var error = document.getElementById('form-error');
    var reset = document.getElementById('form-reset');
    var btn = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      error.hidden = true;
      btn.disabled = true;
      btn.textContent = 'Sending…';
      fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
        .then(function (res) {
          if (!res.ok) throw new Error('Request failed');
          form.reset();
          form.hidden = true;
          thanks.hidden = false;
          window.scrollTo(0, 0);
        })
        .catch(function () { error.hidden = false; })
        .finally(function () { btn.disabled = false; btn.textContent = 'Send request'; });
    });

    reset.addEventListener('click', function () {
      thanks.hidden = true;
      form.hidden = false;
    });
  })();
</script>
