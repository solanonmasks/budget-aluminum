---
import Base from '../layouts/Base.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import { site, images, galleryPreview } from '../data/site.js';

const tel = `tel:${site.phone.tel}`;

const stats = [
  { big: '1 day', small: 'most installs, start to finish', pad: '28px 24px 34px 0' },
  { big: 'Financing', small: 'monthly payment plans available', pad: '28px 24px 34px' },
  { big: 'WCB', small: 'WorkSafe BC covered', pad: '28px 24px 34px' },
  { big: '2022', small: 'Best Businesses in Canada', pad: '28px 0 34px 24px' },
];

const services = [
  { num: '01', title: 'Patio covers', desc: 'Full glass, aluminium or a mix, on powder-coated aluminium or wood frames.', items: ['Tempered glass', 'W-panel', 'Polycarbonate', 'Insulated'] },
  { num: '02', title: 'Sunrooms', desc: 'Enclosed glass rooms that extend the house into the yard.', items: ['Solariums', 'Glass walls'] },
  { num: '03', title: 'Railings', desc: 'Aluminium picket, tempered glass and frameless glass railings for decks and stairs.', items: ['Picket', 'Glass', 'Frameless'] },
  { num: '04', title: 'Fences and gates', desc: 'Aluminium fences, SleekFence horizontal slats, and manual or remote-control gates.', items: ['SleekFence', 'Motorized gates'] },
  { num: '05', title: 'Decks', desc: 'Treated wood, cedar, composite, Trex and vinyl decks, custom built.', items: ['Composite', 'Trex', 'Cedar'] },
  { num: '06', title: 'Renovations', desc: 'Repairs, restorations and multi-phase home projects, planned and managed.', items: ['New construction', 'Repairs'] },
];

const steps = [
  { n: '01', strong: 'Free estimate.', text: 'We measure, show you cover and railing options, and price it to your budget.' },
  { n: '02', strong: 'Custom fabrication.', text: 'Frames and panels made to your exact sizes and colour.' },
  { n: '03', strong: 'Installed, usually in a day.', text: 'Larger multi-phase jobs are planned and managed for you.' },
];
---
<Base
  title="Budget Aluminium | Patio covers, railings and aluminium fences in the Lower Mainland"
  description="Glass and aluminium patio covers, sunrooms, railings, SleekFence aluminium fences and motorized gates from Richmond to Chilliwack. Most jobs installed in one day. Free estimates."
>
<main>
  <section style="background:#17191B;color:#EDEFF1;overflow:hidden">
    <div style="max-width:1440px;margin:0 auto;padding:clamp(40px,5vw,80px) clamp(20px,4vw,56px) 0">
      <h1 style="font-family:'Sora',sans-serif;font-weight:800;font-size:clamp(54px,8vw,144px);line-height:0.9;letter-spacing:-0.05em;margin:0;max-width:11em">Outdoor living, <span style="color:#C9A23A">covered.</span></h1>
      <div style="display:flex;flex-wrap:wrap;gap:24px 56px;align-items:flex-end;justify-content:space-between;margin-top:30px">
        <p style="margin:0;max-width:34em;font-size:clamp(18px,1.5vw,21px);color:#C9CDD1">Glass and aluminium patio covers, sunrooms, railings, modern aluminium fences and motorized gates, built to handle Lower Mainland rain. Most jobs installed in one day.</p>
        <div style="display:flex;flex-wrap:wrap;gap:10px">
          <a href="/contact" class="btn-gold" style="font-size:18px;padding:19px 30px">Book a Free Estimate</a>
          <a href={tel} class="btn-outline-light" style="font-size:18px;padding:17px 28px">{site.phone.display}</a>
        </div>
      </div>
      <HeroCarousel />
    </div>
  </section>

  <section style="background:#17191B;color:#EDEFF1">
    <div style="max-width:1440px;margin:0 auto;padding:0 clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr))">
      {stats.map((s) => (
        <div style={`padding:${s.pad}`}><span style="display:block;font-family:'Sora',sans-serif;font-weight:800;font-size:44px;line-height:1;letter-spacing:-0.03em;color:#C9A23A">{s.big}</span>{s.small}</div>
      ))}
    </div>
  </section>

  <section style="max-width:1440px;margin:0 auto;padding:clamp(64px,8vw,120px) clamp(20px,4vw,56px)">
    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:20px 60px;margin-bottom:clamp(32px,4vw,52px)">
      <h2 style="font-family:'Sora',sans-serif;font-weight:800;font-size:clamp(44px,5.4vw,92px);line-height:0.94;letter-spacing:-0.045em;margin:0">Built in aluminium, <span style="color:#7A5F14">glass and wood.</span></h2>
      <p style="margin:0;max-width:26em;color:#3D4247">Custom-sized for your house, powder coated to last, and quoted to your budget.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:2px;background:#9EA4A9">
      {services.map((s) => (
        <div style="background:#E6E8EA;padding:clamp(26px,3vw,40px);display:flex;flex-direction:column;gap:12px">
          <span style="font-family:'Sora',sans-serif;font-weight:700;font-size:15px;color:#7A5F14">{s.num}</span>
          <h3 style="font-family:'Sora',sans-serif;font-weight:800;font-size:clamp(28px,2.4vw,36px);letter-spacing:-0.03em;line-height:1.05;margin:0">{s.title}</h3>
          <p style="margin:0;color:#3D4247;font-size:17px">{s.desc}</p>
          <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:4px">
            {s.items.map((it) => <span style="background:#17191B;color:#EDEFF1;font-size:14px;font-weight:600;padding:5px 10px">{it}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section style="background:#17191B;color:#EDEFF1">
    <div style="max-width:1440px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,520px),1fr))">
      <div style="position:relative;min-height:480px"><img src={images.sleekFence.img} alt={images.sleekFence.alt} loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" /></div>
      <div style="padding:clamp(48px,6vw,96px) clamp(20px,4vw,72px);display:flex;flex-direction:column;gap:22px;justify-content:center">
        <span style="font-weight:700;font-size:13px;letter-spacing:0.22em;color:#C9A23A">NEW · SLEEKFENCE™</span>
        <h2 style="font-family:'Sora',sans-serif;font-weight:800;font-size:clamp(44px,5vw,84px);line-height:0.94;letter-spacing:-0.045em;margin:0">The modern fence you’ll never replace.</h2>
        <p style="margin:0;color:#C9CDD1">Horizontal slat fencing in 100% 6063-T5 aluminium with a heavy-duty powder coat. No staining, no rot, no rust. Matching pedestrian and driveway gates.</p>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#3A3E42;border:1px solid #3A3E42">
          <div style="background:#17191B;padding:18px 20px"><strong style="display:block;color:#C9A23A">Zero maintenance</strong>Just an occasional rinse.</div>
          <div style="background:#17191B;padding:18px 20px"><strong style="display:block;color:#C9A23A">Lifetime warranty</strong>Limited, from the manufacturer.</div>
        </div>
      </div>
    </div>
  </section>

  <section style="max-width:1440px;margin:0 auto;padding:clamp(64px,8vw,120px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:40px 96px">
    <h2 style="font-family:'Sora',sans-serif;font-weight:800;font-size:clamp(44px,5vw,84px);line-height:0.94;letter-spacing:-0.045em;margin:0">One crew from <span style="color:#7A5F14">estimate to install.</span></h2>
    <div style="display:flex;flex-direction:column">
      {steps.map((st, i) => (
        <div style={`display:grid;grid-template-columns:56px minmax(0,1fr);gap:14px;padding:20px 0;border-top:2px solid #17191B${i === steps.length - 1 ? ';border-bottom:2px solid #17191B' : ''}`}><span style="font-family:'Sora',sans-serif;font-weight:800;font-size:28px">{st.n}</span><span><strong>{st.strong}</strong> {st.text}</span></div>
      ))}
    </div>
  </section>

  <section style="background:#C9A23A;color:#17191B">
    <div style="max-width:1440px;margin:0 auto;padding:clamp(48px,6vw,80px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:24px 80px;align-items:center">
      <h2 style="font-family:'Sora',sans-serif;font-weight:800;letter-spacing:-0.04em;font-size:clamp(40px,4.6vw,76px);line-height:0.95;margin:0">Spread it out with monthly payments.</h2>
      <div style="display:flex;flex-direction:column;gap:16px;align-items:flex-start"><p style="margin:0;font-size:19px;font-weight:500">Installment plans through Financeit, so the patio cover doesn’t have to wait for next summer.</p><a href={site.links.financeit} target="_blank" rel="noopener" style="background:#17191B;color:#EDEFF1;font-weight:700;font-size:17px;padding:17px 26px;text-decoration:none">Check your payment plan</a></div>
    </div>
  </section>

  <section style="max-width:1440px;margin:0 auto;padding:clamp(64px,8vw,112px) clamp(20px,4vw,56px)">
    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:28px"><h2 style="font-family:'Sora',sans-serif;font-weight:800;letter-spacing:-0.04em;font-size:clamp(44px,5vw,84px);line-height:0.94;margin:0">Recent work</h2><a href="/gallery" style="font-weight:700">Full gallery →</a></div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:4px">
      {galleryPreview.map((g) => (
        <div style="aspect-ratio:4/3;overflow:hidden;background:#9EA4A9"><img src={g.img} alt={g.label} loading="lazy" style="width:100%;height:100%;object-fit:cover" /></div>
      ))}
    </div>
  </section>

  <section style="background:#17191B;color:#EDEFF1">
    <div style="max-width:1440px;margin:0 auto;padding:clamp(56px,7vw,96px) clamp(20px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:28px 80px;align-items:start">
      <h2 style="font-family:'Sora',sans-serif;font-weight:800;font-size:clamp(40px,4.4vw,72px);line-height:0.95;letter-spacing:-0.02em;margin:0">Where we work</h2>
      <div style="display:flex;flex-wrap:wrap;gap:10px 28px;font-size:20px;font-weight:600">
        {site.serviceAreas.map((a) => <span style="border-bottom:3px solid #C9A23A;padding-bottom:4px">{a}</span>)}
        <span style="flex-basis:100%;font-size:17px;font-weight:400;color:#C9CDD1;margin-top:6px">Not on the list? Call anyway. If we can get there, we will.</span>
      </div>
    </div>
  </section>
</main>
</Base>
